---
// Interruptor de modo oscuro. Guarda la preferencia en
// localStorage para recordarla en visitas futuras.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Cambiar entre modo claro y oscuro"
  class="grid size-9 place-items-center rounded-full text-[var(--text-soft)] transition hover:bg-[var(--surface-dim)] hover:text-[var(--text)]"
>
  <!-- Ícono sol (visible en modo oscuro) -->
  <svg
    id="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="hidden size-[19px]"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <!-- Ícono luna (visible en modo claro) -->
  <svg
    id="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    class="size-[19px]"
  >
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path>
  </svg>
</button>

<script>
  function setIcons(isDark: boolean) {
    document.getElementById("icon-sun")?.classList.toggle("hidden", !isDark);
    document.getElementById("icon-moon")?.classList.toggle("hidden", isDark);
  }

  function init() {
    setIcons(document.documentElement.classList.contains("dark"));
    const btn = document.getElementById("theme-toggle");
    btn?.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
      setIcons(isDark);
    });
  }

  init();
  document.addEventListener("astro:after-swap", init);
</script>
