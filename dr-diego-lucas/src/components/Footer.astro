---
import { footerLinks, siteConfig } from "../config/site";

const year = new Date().getFullYear();

// Lista de redes sociales con ícono. Solo se muestran las que
// tengan una URL definida en src/config/site.ts (social.*).
const socials = [
  {
    key: "twitter",
    label: "X / Twitter",
    url: siteConfig.social.twitter,
    path: "M18.9 3H21l-6.3 7.2L22 21h-6.1l-4.8-6.3L5.6 21H3.5l6.7-7.7L3 3h6.2l4.4 5.8L18.9 3Zm-1.1 16.2h1.2L7.3 4.7H6l11.8 14.5Z",
  },
  {
    key: "linkedin",
    label: "LinkedIn",
    url: siteConfig.social.linkedin,
    path: "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2 3.77-2 4.03 0 4.78 2.6 4.78 6V21h-4v-5.6c0-1.35-.02-3.1-1.9-3.1-1.9 0-2.2 1.47-2.2 3v5.7h-4V9Z",
  },
  {
    key: "instagram",
    label: "Instagram",
    url: siteConfig.social.instagram,
    path: "M12 2.2c2.7 0 3 0 4.1.06 1.06.05 1.79.22 2.43.47a4.9 4.9 0 0 1 1.77 1.15 4.9 4.9 0 0 1 1.15 1.77c.25.64.42 1.37.47 2.43.06 1.07.06 1.4.06 4.1s0 3-.06 4.1c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.64.25-1.37.42-2.43.47-1.07.06-1.4.06-4.1.06s-3 0-4.1-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.64-.42-1.37-.47-2.43C2.2 15 2.2 14.7 2.2 12s0-3 .06-4.1c.05-1.06.22-1.79.47-2.43a4.9 4.9 0 0 1 1.15-1.77A4.9 4.9 0 0 1 5.65 2.55c.64-.25 1.37-.42 2.43-.47C9.15 2.02 9.5 2 12.15 2ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 1.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4Zm5.2-2.75a1.17 1.17 0 1 1 0 2.34 1.17 1.17 0 0 1 0-2.34Z",
  },
  {
    key: "youtube",
    label: "YouTube",
    url: siteConfig.social.youtube,
    path: "M22 12s0-3.1-.4-4.6a3 3 0 0 0-2.1-2.1C17.9 5 12 5 12 5s-5.9 0-7.5.3a3 3 0 0 0-2.1 2.1C2 8.9 2 12 2 12s0 3.1.4 4.6a3 3 0 0 0 2.1 2.1c1.6.3 7.5.3 7.5.3s5.9 0 7.5-.3a3 3 0 0 0 2.1-2.1c.4-1.5.4-4.6.4-4.6ZM10 15.5v-7l6 3.5-6 3.5Z",
  },
].filter((s) => s.url);
---

<footer class="border-t border-[var(--line)] bg-[var(--surface-dim)]">
  <div
    class="mx-auto max-w-(--container-page) px-5 py-14 sm:px-8"
  >
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-2xl text-[var(--text)]">
          {siteConfig.siteName}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-soft)]">
          {siteConfig.description}
        </p>
      </div>

      <div class="flex flex-wrap gap-12 sm:gap-16">
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-[var(--text-soft)]">
            Enlaces
          </p>
          <ul class="mt-4 space-y-2.5">
            {
              footerLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-[var(--text)] hover:text-[var(--accent)]"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-[var(--text-soft)]">
            Contacto
          </p>
          <ul class="mt-4 space-y-2.5">
            <li>
              <a
                href={`mailto:${siteConfig.email}`}
                class="text-sm text-[var(--text)] hover:text-[var(--accent)]"
              >
                {siteConfig.email}
              </a>
            </li>
            <li>
              <a
                href="/articulos/feed.xml"
                class="text-sm text-[var(--text)] hover:text-[var(--accent)]"
              >
                RSS
              </a>
            </li>
          </ul>
        </div>

        {
          socials.length > 0 && (
            <div>
              <p class="text-xs font-medium uppercase tracking-wider text-[var(--text-soft)]">
                Redes
              </p>
              <ul class="mt-4 flex gap-3">
                {socials.map((s) => (
                  <li>
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={s.label}
                      class="grid size-8 place-items-center rounded-full text-[var(--text-soft)] transition hover:bg-[var(--surface)] hover:text-[var(--accent)]"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-4 fill-current">
                        <path d={s.path} />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-[var(--line)] pt-6 text-xs text-[var(--text-soft)] sm:flex-row sm:justify-between"
    >
      <p>© {year} {siteConfig.siteName}. Todos los derechos reservados.</p>
      <p>Editorial · Minimalista · Atemporal</p>
    </div>
  </div>
</footer>
