---
import { getCollection } from "astro:content";
import ArticuloCard from "./ArticuloCard.astro";
import { siteConfig } from "../config/site";

// Toma los N artículos más recientes (no-borrador) definidos en
// site.ts (featuredCount, entre 3 y 6). No requiere marcar
// manualmente qué artículos son "destacados": siempre son los
// más nuevos.
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const featured = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, siteConfig.featuredCount);
---

{
  featured.length > 0 && (
    <section class="mx-auto max-w-(--container-page) px-5 pb-20 sm:px-8 sm:pb-28">
      <div class="mb-10 flex items-end justify-between">
        <h2 class="font-display text-3xl text-[var(--text)] sm:text-4xl">
          Artículos destacados
        </h2>
        <a
          href="/articulos"
          class="hidden text-sm text-[var(--text-soft)] hover:text-[var(--accent)] sm:inline"
        >
          Ver todos →
        </a>
      </div>

      <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2">
        {featured.map((post, i) => (
          <ArticuloCard post={post} size={i === 0 ? "grande" : "normal"} />
        ))}
      </div>
    </section>
  )
}
