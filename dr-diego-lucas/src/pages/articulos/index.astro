---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticuloCard from "../../components/ArticuloCard.astro";
import { slugify } from "../../lib/utils";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Sistema de categorías 100% automático: se calcula a partir de
// las categorías presentes en los artículos, nunca se declara a mano.
// Cada categoría enlaza a su página dedicada en /categorias/[categoria].
const categories = [...new Set(posts.map((p) => p.data.category))].sort();
---

<BaseLayout
  title="Artículos"
  description="Todos los artículos, ensayos e investigaciones publicados."
>
  <div class="mx-auto max-w-(--container-page) px-5 pb-24 pt-16 sm:px-8 sm:pt-20">
    <header class="max-w-2xl">
      <h1 class="font-display text-4xl text-[var(--text)] sm:text-5xl">
        Artículos
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-[var(--text-soft)]">
        Ensayos e investigaciones sobre salud, tecnología y las preguntas que
        importan.
      </p>
    </header>

    <!-- Categorías (enlazan a su página dedicada) -->
    <div class="mt-10 flex flex-wrap gap-2 border-b border-[var(--line)] pb-8">
      {
        categories.map((cat) => (
          <a
            href={`/categorias/${slugify(cat)}`}
            class="rounded-full border border-[var(--line)] px-4 py-1.5 text-sm text-[var(--text-soft)] transition hover:border-[var(--accent)] hover:text-[var(--accent)]"
          >
            {cat}
          </a>
        ))
      }
    </div>

    {
      posts.length > 0 ? (
        <div class="mt-14 grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <ArticuloCard post={post} />
          ))}
        </div>
      ) : (
        <p class="mt-16 text-[var(--text-soft)]">
          Todavía no hay artículos publicados en esta categoría.
        </p>
      )
    }
  </div>
</BaseLayout>
